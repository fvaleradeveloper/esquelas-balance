# ============================================
# CONFIGURACIÓN DE ENTORNO - Esquelas-Balance
# ============================================
# Copiar este archivo a .env y ajustar los valores

# Puerto del servidor (desarrollo local)
PORT=3100

# Entorno (development | production)
NODE_ENV=development

# Secreto para JWT (mínimo 32 caracteres, cambiar en producción)
JWT_SECRET=tu_secreto_jwt_muy_seguro_cambiar_en_produccion_2026

# Credenciales administrador del sistema
ADMIN_EMAIL=admin@esquelas-balance.local
ADMIN_PASSWORD=Admin12345

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3100

# ============================================
# BASE DE DATOS - Neon (PostgreSQL)
# ============================================
# Para despliegue en Vercel + Neon, configurar:
# DATABASE_URL=postgresql://usuario:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ============================================
# WHATSAPP (sin API - uso de wa.me directo)
# ============================================
# No se requiere API key. Se usa https://wa.me/<telefono>?text=<mensaje>